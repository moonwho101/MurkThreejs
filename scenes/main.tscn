[connection signal="pressed" from="UICanvas/SplashScreen/StartButton" to="." method="show_select"]
[connection signal="pressed" from="UICanvas/SelectScreen/CharGrid/BtnWarrior" to="." method="start_game" binds= ["fighter"]]
[connection signal="pressed" from="UICanvas/SelectScreen/CharGrid/BtnCleric" to="." method="start_game" binds= ["cleric"]]
[connection signal="pressed" from="UICanvas/SelectScreen/CharGrid/BtnThief" to="." method="start_game" binds= ["thief"]]
[connection signal="pressed" from="UICanvas/SelectScreen/CharGrid/BtnWizard" to="." method="start_game" binds= ["wizard"]]
[connection signal="pressed" from="UICanvas/HUD/BottomPanel/Buttons/BtnRing" to="." method="use_ring"]
[connection signal="pressed" from="UICanvas/HUD/BottomPanel/Buttons/BtnDrop" to="." method="drop_relic"]
[connection signal="pressed" from="UICanvas/HUD/BottomPanel/Buttons/BtnStairs" to="." method="use_stairs"]
[connection signal="pressed" from="UICanvas/HUD/BottomPanel/Buttons/BtnMap" to="." method="toggle_map"]
[connection signal="pressed" from="UICanvas/HUD/BottomPanel/Buttons/BtnMenu" to="." method="toggle_pause"]
[connection signal="pressed" from="UICanvas/ModalScreen/Panel/BtnClose" to="." method="on_modal_close"]
[connection signal="pressed" from="UICanvas/PauseScreen/Panel/VBox/BtnResume" to="." method="toggle_pause"]
[connection signal="pressed" from="UICanvas/PauseScreen/Panel/VBox/BtnRestart" to="." method="begin_episode"]
[connection signal="pressed" from="UICanvas/PauseScreen/Panel/VBox/BtnQuit" to="." method="show_splash"]
[connection signal="pressed" from="UICanvas/PerkScreen/Cards/BtnPerkDamage" to="." method="select_perk" binds= ["damage"]]
[connection signal="pressed" from="UICanvas/PerkScreen/Cards/BtnPerkShots" to="." method="select_perk" binds= ["shots"]]
[connection signal="pressed" from="UICanvas/PerkScreen/Cards/BtnPerkSpeed" to="." method="select_perk" binds= ["speed"]]
